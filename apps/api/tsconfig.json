{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "prisma", "tests", "vitest.config.ts", "tsup.config.ts"],
  // src/index.ts importe le bundle `dist/` (généré par tsup) : il est vérifié par tsconfig.build.json, après le bundling.
  "exclude": ["node_modules", "dist", "src/index.ts"]
}
