# ───────────── Frontend (apps/web) ─────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="Ali Prestige"
NEXT_PUBLIC_CURRENCY=DZD

# "mock" = données locales dans le navigateur (phase 1) ; "api" = vrai serveur (phase 2).
NEXT_PUBLIC_DATA_SOURCE=mock
# URL du serveur API pour les appels faits PAR le serveur Next (rendu serveur) et pour la réécriture /api/*.
# Les appels du navigateur passent par /api/* (même origine) : jamais d'URL d'API publique à exposer.
API_INTERNAL_URL=http://localhost:4000

# ───────────── API (apps/api) ─────────────
PORT=4000
NODE_ENV=development
# Développement : `pnpm --filter @fashion/api dev:db` lance un vrai PostgreSQL sur le port 5433.
DATABASE_URL="postgresql://fashion:fashion@localhost:5433/fashion?schema=public"
# Production : secret aléatoire d'au moins 32 caractères (openssl rand -base64 48).
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
SESSION_HOURS=12
# Origines du site autorisées (séparées par des virgules).
WEB_ORIGIN=http://localhost:3000

# Compte propriétaire créé par `pnpm --filter @fashion/api db:seed` (mot de passe : ≥ 12 caractères).
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Images : "local" (développement, dossier uploads/) ou "cloudinary" (production).
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=maison-atlas

RATE_LIMIT=on
LOG_LEVEL=info
